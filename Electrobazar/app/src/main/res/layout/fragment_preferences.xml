<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/android:windowBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Preferencias"
            android:textColor="?attr/android:textColorPrimary"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="24dp" />

        <!-- Appearance (Dark/Light) -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="?attr/colorSurface"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Apariencia"
                    android:textColor="?attr/android:textColorSecondary"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp" />

                <RadioGroup
                    android:id="@+id/rgTheme"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/rbDark"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Oscuro"
                        android:textColor="?attr/android:textColorPrimary"
                        android:buttonTint="?attr/colorPrimary" />

                    <RadioButton
                        android:id="@+id/rbLight"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Claro"
                        android:textColor="?attr/android:textColorPrimary"
                        android:buttonTint="?attr/colorPrimary" />
                </RadioGroup>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Font Size -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="?attr/colorSurface"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tamaño de letra"
                    android:textColor="?attr/android:textColorSecondary"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp" />

                <RadioGroup
                    android:id="@+id/rgFontSize"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <RadioButton android:id="@+id/rbFontSizeSmall" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Pequeño" android:textColor="?attr/android:textColorPrimary" android:buttonTint="?attr/colorPrimary" />
                    <RadioButton android:id="@+id/rbFontSizeNormal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Normal" android:textColor="?attr/android:textColorPrimary" android:buttonTint="?attr/colorPrimary" />
                    <RadioButton android:id="@+id/rbFontSizeLarge" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Grande" android:textColor="?attr/android:textColorPrimary" android:buttonTint="?attr/colorPrimary" />
                    <RadioButton android:id="@+id/rbFontSizeXL" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Extra" android:textColor="?attr/android:textColorPrimary" android:buttonTint="?attr/colorPrimary" />
                </RadioGroup>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Font Type -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="?attr/colorSurface"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tipo de letra"
                    android:textColor="?attr/android:textColorSecondary"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp" />

                <RadioGroup
                    android:id="@+id/rgFontType"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <RadioButton android:id="@+id/rbFontBarlow" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Barlow" android:textColor="?attr/android:textColorPrimary" android:buttonTint="?attr/colorPrimary" />
                    <RadioButton android:id="@+id/rbFontModerno" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Moderno (Montserrat)" android:textColor="?attr/android:textColorPrimary" android:buttonTint="?attr/colorPrimary" />
                    <RadioButton android:id="@+id/rbFontClasico" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Clásico (Playfair)" android:textColor="?attr/android:textColorPrimary" android:buttonTint="?attr/colorPrimary" />
                    <RadioButton android:id="@+id/rbFontRounded" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Rounded (Quicksand)" android:textColor="?attr/android:textColorPrimary" android:buttonTint="?attr/colorPrimary" />
                </RadioGroup>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Accent Color -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="?attr/colorSurface"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Color de acento"
                    android:textColor="?attr/android:textColorSecondary"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp" />

                <GridLayout
                    android:id="@+id/accentGrid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="4"
                    android:alignmentMode="alignMargins"
                    android:useDefaultMargins="true">
                    <!-- Colors will be added programmatically or as static views -->
                </GridLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Background Tone -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="?attr/colorSurface"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tono de fondo"
                    android:textColor="?attr/android:textColorSecondary"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp" />

                <GridLayout
                    android:id="@+id/primaryGrid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="3"
                    android:alignmentMode="alignMargins"
                    android:useDefaultMargins="true">
                </GridLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Reset Button -->
        <Button
            android:id="@+id/btnReset"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Restablecer"
            android:backgroundTint="?attr/colorError"
            android:textColor="?attr/android:windowBackground"
            android:layout_marginTop="20dp" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
