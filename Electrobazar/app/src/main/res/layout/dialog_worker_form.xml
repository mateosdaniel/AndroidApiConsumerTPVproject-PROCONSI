<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/dialogRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/colorSurface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/dialogTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:text="Trabajador"
            android:textColor="?attr/android:textColorPrimary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- Nombre de usuario -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:hint="Nombre de usuario *"
            app:boxStrokeColor="?attr/colorPrimary"
            app:hintTextColor="?attr/android:textColorSecondary">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editWorkerUsername"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:textColor="?attr/android:textColorPrimary" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Contraseña -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/workerPasswordLayout"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:hint="Contraseña *"
            app:boxStrokeColor="?attr/colorPrimary"
            app:hintTextColor="?attr/android:textColorSecondary"
            app:endIconMode="password_toggle">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editWorkerPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPassword"
                android:textColor="?attr/android:textColorPrimary" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Rol: usando TextInputLayout estilo ExposedDropdownMenu -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/workerRoleLayout"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:hint="Rol *"
            app:boxStrokeColor="?attr/colorPrimary"
            app:hintTextColor="?attr/android:textColorSecondary">

            <AutoCompleteTextView
                android:id="@+id/editWorkerRoleSpinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:focusable="false"
                android:inputType="none"
                android:textColor="?attr/android:textColorPrimary"
                android:textColorHint="?attr/android:textColorSecondary"
                android:background="@null"
                android:padding="16dp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Estado activo -->
        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/editWorkerActiveSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:checked="true"
            android:text="Trabajador Activo"
            android:textColor="?attr/android:textColorPrimary"
            app:thumbTint="?attr/colorPrimary"
            app:trackTint="?attr/colorPrimary" />

        <!-- Botones -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/cancelWorkerBtn"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CANCELAR"
                android:textColor="?attr/android:textColorSecondary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/saveWorkerBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="GUARDAR"
                app:backgroundTint="?attr/colorPrimary"
                app:cornerRadius="8dp" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>
