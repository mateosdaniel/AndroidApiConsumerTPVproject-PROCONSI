<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardBackgroundColor="@color/primary_variant"
    app:cardCornerRadius="12dp"
    app:strokeColor="@color/border"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/returnNumber"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="D-2026-0001"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/returnDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="13/03/2026 14:30"
                android:textColor="@color/text_muted"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/returnSaleRef"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ticket Ref: #123"
            android:textColor="@color/text_muted"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/returnWorker"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Atendido por: Admin"
            android:textColor="@color/text_muted"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/refundMethod"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CASH"
                android:textColor="@color/info"
                android:textStyle="bold"
                android:background="@drawable/bg_rounded_card"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:textSize="12sp" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/refundAmount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="45.00€"
                android:textColor="@color/danger"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/border"
            android:layout_marginVertical="12dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDownloadPdf"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="DESCARGAR PDF"
            android:textColor="@color/accent"
            app:icon="@android:drawable/stat_sys_download"
            app:iconTint="@color/accent" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
