        <item name="android:navigationBarColor">@android:color/black</item>
        <item name="colorSurface">@color/light0_surface</item>
        <item name="colorSurfaceVariant">@color/light0_secondary</item>
        <item name="colorOutline">@color/light_border</item>
        <item name="android:textColorPrimary">@color/light_text</item>
        <item name="android:textColorSecondary">@color/light_muted</item>
        <item name="android:textColorHint">@color/light_muted</item>
        <item name="colorOnSurface">@color/light_text</item>
        <item name="colorOnSurfaceVariant">@color/light_muted</item>
        <!-- Default light accent: monochrome = black — matches web lightAccent default=0 -->
        <item name="colorPrimary">@color/accent_0_light</item>
        <item name="colorOnPrimary">@color/light0_primary</item>
        <item name="colorSecondary">@color/accent_0_light</item>
        <item name="colorOnSecondary">@color/light0_primary</item>
    </style>

