<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/android:windowBackground">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Loading State -->
            <ProgressBar
                android:id="@+id/loadingProgress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:visibility="gone" />

            <!-- State 1: Open Register Form (Centered in landscape) -->
            <LinearLayout
                android:id="@+id/openFormContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Apertura de Caja"
                    android:textColor="?attr/android:textColorPrimary"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="24dp" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="500dp"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="?attr/colorSurface"
                    app:cardCornerRadius="12dp"
                    app:strokeColor="?attr/colorOutline"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Saldo Inicial"
                            android:textColor="?attr/android:textColorSecondary"
                            android:textSize="14sp"
                            android:layout_marginBottom="8dp" />

                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:boxStrokeColor="?attr/colorPrimary"
                            app:hintEnabled="false"
                            android:layout_marginBottom="20dp">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/openingBalanceInput"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="0.00"
                                android:inputType="numberDecimal"
                                android:textColor="?attr/android:textColorPrimary"
                                android:background="@android:color/transparent" />

                        </com.google.android.material.textfield.TextInputLayout>

                        <TextView
                            android:id="@+id/suggestionText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Sugerido del turno anterior"
                            android:textColor="@color/info"
                            android:layout_marginBottom="20dp"
                            android:visibility="gone" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnOpenRegister"
                            android:layout_width="match_parent"
                            android:layout_height="56dp"
                            android:text="ABRIR CAJA"
                            android:backgroundTint="?attr/colorPrimary"
                            android:textColor="?attr/android:windowBackground"
                            app:cornerRadius="8sp" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- State 2: Active Register Dashboard (TWO COLUMNS) -->
            <LinearLayout
                android:id="@+id/activeRegisterContainer"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:visibility="gone">

                <!-- Left Column: Totals & Info -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingEnd="8dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Panel de Control de Caja"
                        android:textColor="?attr/android:textColorPrimary"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="12dp" />

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:cardBackgroundColor="?attr/colorSurface"
                        app:cardCornerRadius="12dp"
                        app:strokeColor="?attr/colorOutline"
                        app:strokeWidth="1dp"
                        android:layout_marginBottom="12dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="12dp">
                            <TextView android:id="@+id/shiftWorkerText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Trabajador: Admin" android:textColor="?attr/android:textColorPrimary" />
                            <TextView android:id="@+id/shiftOpeningTimeText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Apertura: 09:00" android:textColor="?attr/android:textColorSecondary" android:textSize="12sp" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <GridLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:columnCount="2">
                        <!-- Totals duplicated from portrait... -->
                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_columnWeight="1"
                            android:layout_margin="4dp"
                            app:cardBackgroundColor="?attr/colorSurface"
                            app:cardCornerRadius="8dp">
                            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="10dp">
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Ventas Efectivo" android:textColor="?attr/android:textColorSecondary" android:textSize="11sp" />
                                <TextView android:id="@+id/cashSalesText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0.00€" android:textColor="@color/success" android:textSize="16sp" android:textStyle="bold" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>
                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_columnWeight="1"
                            android:layout_margin="4dp"
                            app:cardBackgroundColor="?attr/colorSurface"
                            app:cardCornerRadius="8dp">
                            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="10dp">
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Ventas Tarjeta" android:textColor="?attr/android:textColorSecondary" android:textSize="11sp" />
                                <TextView android:id="@+id/cardSalesText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0.00€" android:textColor="@color/info" android:textSize="16sp" android:textStyle="bold" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>
                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_columnWeight="1"
                            android:layout_margin="4dp"
                            app:cardBackgroundColor="?attr/colorSurface"
                            app:cardCornerRadius="8dp">
                            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="10dp">
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Retiradas" android:textColor="?attr/android:textColorSecondary" android:textSize="11sp" />
                                <TextView android:id="@+id/withdrawalsText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0.00€" android:textColor="@color/danger" android:textSize="16sp" android:textStyle="bold" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>
                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_columnWeight="1"
                            android:layout_margin="4dp"
                            app:cardBackgroundColor="?attr/colorSurface"
                            app:cardCornerRadius="8dp">
                            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="10dp">
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Saldo Esperado" android:textColor="?attr/android:textColorPrimary" android:textSize="11sp" />
                                <TextView android:id="@+id/expectedBalanceText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0.00€" android:textColor="?attr/colorPrimary" android:textSize="16sp" android:textStyle="bold" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>
                    </GridLayout>

                        <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnGotoClose"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="CERRAR SESIÓN DE CAJA"
                        android:backgroundTint="?attr/colorError"
                        android:textColor="?attr/android:windowBackground" />
                </LinearLayout>

                <!-- Right Column: Movements & Recent -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.2"
                    android:orientation="vertical"
                    android:paddingStart="8dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="8dp"
                        android:gravity="center_vertical">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Movimientos Recientes"
                            android:textColor="?attr/android:textColorSecondary"
                            android:textSize="14sp" />
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnNewMovement"
                            style="@style/Widget.MaterialComponents.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="+ MOVIMIENTO"
                            android:textColor="?attr/colorPrimary" />
                    </LinearLayout>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/movementsRecyclerView"
                        android:layout_width="match_parent"
                        android:layout_height="400dp"
                        android:background="@drawable/bg_rounded_card" />

                </LinearLayout>

            </LinearLayout>

            <!-- State 3: Movement Form (Centered in landscape) -->
            <LinearLayout
                android:id="@+id/movementFormContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nuevo Movimiento"
                    android:textColor="?attr/android:textColorPrimary"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="24dp" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="500dp"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="?attr/colorSurface"
                    app:cardCornerRadius="12dp"
                    app:strokeColor="?attr/colorOutline"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <com.google.android.material.button.MaterialButtonToggleGroup
                            android:id="@+id/movementTypeGroup"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:singleSelection="true"
                            app:selectionRequired="true"
                            app:checkedButton="@+id/btnWithdrawal"
                            android:layout_marginBottom="16dp">
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnWithdrawal"
                                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="RETIRADA"
                                app:strokeColor="?attr/colorOutline" />
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnEntry"
                                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="ENTRADA"
                                app:strokeColor="?attr/colorOutline" />
                        </com.google.android.material.button.MaterialButtonToggleGroup>

                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Importe"
                            app:boxStrokeColor="?attr/colorPrimary"
                            android:layout_marginBottom="16dp">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/movementAmountInput"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="numberDecimal"
                                android:textColor="?attr/android:textColorPrimary" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Concepto / Motivo"
                            app:boxStrokeColor="?attr/colorPrimary"
                            android:layout_marginBottom="24dp">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/movementReasonInput"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textColor="?attr/android:textColorPrimary" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSubmitMovement"
                            android:layout_width="match_parent"
                            android:layout_height="56dp"
                            android:text="CONFIRMAR MOVIMIENTO"
                            android:backgroundTint="?attr/colorPrimary"
                            android:textColor="?attr/android:windowBackground" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnCancelMovement"
                            style="@style/Widget.MaterialComponents.Button.TextButton"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="VOLVER"
                            android:textColor="?attr/android:textColorSecondary"
                            android:layout_marginTop="8dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- State 4: Close Register Form (Centered in landscape) -->
            <LinearLayout
                android:id="@+id/closeFormContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cierre de Caja"
                    android:textColor="?attr/android:textColorPrimary"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="24dp" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="550dp"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="?attr/colorSurface"
                    app:cardCornerRadius="12dp"
                    app:strokeColor="?attr/colorOutline"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <TextView
                            android:id="@+id/closeTheoryAmountText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Efectivo Teórico: 0.00€"
                            android:textColor="?attr/android:textColorPrimary"
                            android:textSize="18sp"
                            android:layout_marginBottom="24dp" />

                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Efectivo Real en Caja"
                            app:boxStrokeColor="?attr/colorPrimary"
                            android:layout_marginBottom="8dp">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/closeRealAmountInput"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="numberDecimal"
                                android:textColor="?attr/android:textColorPrimary" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <TextView
                            android:id="@+id/closeDifferenceText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Diferencia: 0.00€"
                            android:textColor="?attr/android:textColorSecondary"
                            android:layout_marginBottom="24dp" />

                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/retainToggle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Retener efectivo para siguiente turno"
                            android:textColor="?attr/android:textColorPrimary"
                            android:layout_marginBottom="16dp" />

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/retainedAmountLayout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Cantidad a retener"
                            app:boxStrokeColor="?attr/colorPrimary"
                            android:layout_marginBottom="16dp"
                            android:visibility="gone">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/retainedAmountInput"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="numberDecimal"
                                android:textColor="?attr/android:textColorPrimary" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Notas de cierre"
                            app:boxStrokeColor="?attr/colorPrimary"
                            android:layout_marginBottom="24dp">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/closeNotesInput"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textColor="?attr/android:textColorPrimary" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSubmitClose"
                            android:layout_width="match_parent"
                            android:layout_height="56dp"
                            android:text="CONFIRMAR CIERRE"
                            android:backgroundTint="?attr/colorError"
                            android:textColor="?attr/android:windowBackground" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnCancelClose"
                            style="@style/Widget.MaterialComponents.Button.TextButton"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="VOLVER"
                            android:textColor="?attr/android:textColorSecondary"
                            android:layout_marginTop="8dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
